# FixProof Environment Configuration

# Optional: Google Gemini Multimodal API Key for live AI Visual Verification
# When unset, FixProof runs on its calibrated local Computer Vision Evidence Engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database configuration (built-in SQLite via node:sqlite in Node 22+)
DATABASE_PATH=./data/fixproof.sqlite

# Application Port
PORT=3000

