# ==============================================================================
# FIXPROOF — ENVIRONMENT CONFIGURATION
# "Reported. Repaired. Verified."
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Project Settings -> API & Database:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Optional: Direct PostgreSQL Connection URI (for Prisma, Drizzle, or pg migrations)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. AI & COMPUTER VISION CONFIGURATION
# ------------------------------------------------------------------------------
# Google Gemini Multimodal API Key for live AI Visual Verification
# When unset, FixProof runs on its calibrated local Computer Vision Evidence Engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# 32+ character random secret for HMAC SHA-256 session tokens and tamper detection
AUTH_SECRET=fixproof-production-security-secret-key-2026-sha256

# ------------------------------------------------------------------------------
# 4. SERVER & PLATFORM SETTINGS
# ------------------------------------------------------------------------------
# Default port for Render is 10000, local is 3000
PORT=3000
NODE_ENV=production
